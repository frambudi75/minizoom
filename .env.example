# ===================================================
# MINIZOOM ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi `.env` lalu isi dengan nilai yang sesuai:
# cp .env.example .env
# ===================================================

# LiveKit Server Configuration
# Jika menggunakan LiveKit Cloud:
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_api_key_here
# LIVEKIT_API_SECRET=your_api_secret_here
#
# Jika menggunakan LiveKit Server Lokal (bawaan docker-compose):
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional: Konfigurasi Email SMTP (Bisa juga diatur lewat menu Superadmin Dashboard)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@minizoom.local

# Optional: Discord Webhook Alert (Bisa juga diatur lewat menu Superadmin Dashboard)
DISCORD_WEBHOOK_URL=
